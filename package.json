{
  "name": "survey-platform-backend",
  "version": "1.0.0",
  "description": "Indonesian Survey Platform Backend - Production Ready",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node src/database/migrations.ts",
    "seed": "ts-node src/database/seed.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "agents": "omc team --gsd-core --superpowers --caveman",
    "agents:ultrawork": "omc ultrawork --gsd-core --superpowers --caveman",
    "agents:deep": "omc deepsearch --caveman",
    "automation:status": "echo 'OMC HUD: http://localhost:6006' && echo 'GSD Dashboard: http://localhost:8080'",
    "automation:cost": "cat .caveman-stats.json || echo 'No cost stats yet'"
  },
  "keywords": ["survey", "indonesia", "api", "backend"],
  "author": "Nikki Antonio Saputra",
  "license": "MIT",
  "dependencies": {
   "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "ws": "^8.15.0",
    "uuid": "^9.0.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}